SHORTENER_DB_PATH=./data/shortener.sqlite3
# Set this to the externally reachable URL when behind a trusted reverse proxy.
SHORTENER_PUBLIC_BASE_URL=
SHORTENER_CREATE_LIMIT=60
SHORTENER_CREATE_WINDOW_SECONDS=60
SHORTENER_MAX_EXPIRY_SECONDS=31536000
# Optional OpenAI-compatible SDLC agent endpoint (Ollama or a remote provider).
# Code generation remains incomplete when AGENT_BASE_URL is unset.
AGENT_BASE_URL=
AGENT_MODEL=your-coding-model
AGENT_API_KEY=
AGENT_TIMEOUT_SECONDS=120
